{
  "info": {
    "name": "CEVCMS EPIC-6 QA-004 Authentication and RBAC Security",
    "description": "Sanitized live QA-004 matrix. Supply synthetic local credentials only at runtime. This collection stores no password, token, signing secret, signature, or personal data.",
