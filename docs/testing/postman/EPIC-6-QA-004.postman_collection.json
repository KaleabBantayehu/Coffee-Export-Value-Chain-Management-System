  "item": [
    {"name":"Authentication and role identity","item":[
      {"name":"Invalid credentials are generic","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-Forwarded-For","value":"10.4.0.1"}],"body":{"mode":"raw","raw":"{\"username\":\"missing-qa004\",\"password\":\"invalid-synthetic-password\"}"},"url":"{{baseUrl}}/api/v1/auth/login"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns 401',()=>pm.response.to.have.status(401));","pm.expect(pm.response.json().detail).to.eql('Invalid username or password.');"]}}]},
      {"name":"Missing login field is bounded","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-Forwarded-For","value":"10.4.0.2"}],"body":{"mode":"raw","raw":"{\"username\":\"missing-password\"}"},"url":"{{baseUrl}}/api/v1/auth/login"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns 400',()=>pm.response.to.have.status(400));","pm.expect(pm.response.json().detail).to.be.a('string').and.not.empty;"]}}]},
      {"name":"Malformed login JSON is bounded","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-Forwarded-For","value":"10.4.0.3"}],"body":{"mode":"raw","raw":"{invalid-json"},"url":"{{baseUrl}}/api/v1/auth/login"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns 400',()=>pm.response.to.have.status(400));","pm.expect(pm.response.json().detail).to.be.a('string').and.not.empty;"]}}]},
      {"name":"Admin login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-Forwarded-For","value":"10.4.1.1"}],"body":{"mode":"raw","raw":"{\"username\":\"{{adminUsername}}\",\"password\":\"{{adminPassword}}\"}"},"url":"{{baseUrl}}/api/v1/auth/login"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns Admin token',()=>pm.response.to.have.status(200));","const b=pm.response.json(); pm.expect(b.role).to.eql('Admin'); pm.collectionVariables.set('adminToken',b.access_token);"]}}]},
      {"name":"ECTA Officer login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-Forwarded-For","value":"10.4.1.2"}],"body":{"mode":"raw","raw":"{\"username\":\"{{ectaUsername}}\",\"password\":\"{{ectaPassword}}\"}"},"url":"{{baseUrl}}/api/v1/auth/login"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns ECTA Officer token',()=>pm.response.to.have.status(200));","const b=pm.response.json(); pm.expect(b.role).to.eql('ECTA Officer'); pm.collectionVariables.set('ectaToken',b.access_token);"]}}]},
      {"name":"Field Registry Agent login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-Forwarded-For","value":"10.4.1.3"}],"body":{"mode":"raw","raw":"{\"username\":\"{{fieldUsername}}\",\"password\":\"{{fieldPassword}}\"}"},"url":"{{baseUrl}}/api/v1/auth/login"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns Field Registry Agent token',()=>pm.response.to.have.status(200));","const b=pm.response.json(); pm.expect(b.role).to.eql('Field/Registry Agent'); pm.collectionVariables.set('fieldToken',b.access_token); const id=Date.now().toString(); pm.collectionVariables.set('runId',id); pm.collectionVariables.set('nationalId',`QA004-${id}`);"]}}]},
      {"name":"Verifier login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-Forwarded-For","value":"10.4.1.4"}],"body":{"mode":"raw","raw":"{\"username\":\"{{verifierUsername}}\",\"password\":\"{{verifierPassword}}\"}"},"url":"{{baseUrl}}/api/v1/auth/login"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns Verifier token',()=>pm.response.to.have.status(200));","const b=pm.response.json(); pm.expect(b.role).to.eql('Verifier'); pm.collectionVariables.set('verifierToken',b.access_token);"]}}]},
      {"name":"Admin profile","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"}],"url":"{{baseUrl}}/api/v1/auth/me"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns Admin profile',()=>pm.response.to.have.status(200));","const b=pm.response.json(); pm.expect(b.role).to.eql('Admin'); pm.collectionVariables.set('adminUserId',b.user_id);"]}}]},
      {"name":"ECTA Officer profile","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{ectaToken}}"}],"url":"{{baseUrl}}/api/v1/auth/me"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns ECTA Officer profile',()=>pm.response.to.have.status(200));","const b=pm.response.json(); pm.expect(b.role).to.eql('ECTA Officer'); pm.collectionVariables.set('ectaUserId',b.user_id);"]}}]},
      {"name":"Field Registry Agent profile","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{fieldToken}}"}],"url":"{{baseUrl}}/api/v1/auth/me"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns Field Registry Agent profile',()=>pm.response.to.have.status(200));","const b=pm.response.json(); pm.expect(b.role).to.eql('Field/Registry Agent'); pm.collectionVariables.set('fieldUserId',b.user_id);"]}}]},
      {"name":"Verifier profile","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{verifierToken}}"}],"url":"{{baseUrl}}/api/v1/auth/me"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns Verifier profile',()=>pm.response.to.have.status(200));","const b=pm.response.json(); pm.expect(b.role).to.eql('Verifier'); pm.collectionVariables.set('verifierUserId',b.user_id);"]}}]}
    ]},
    {"name":"Protected and privileged boundaries","item":[
      {"name":"Missing token on protected endpoint","request":{"method":"GET","url":"{{baseUrl}}/api/v1/farms"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns 401',()=>pm.response.to.have.status(401));"]}}]},
      {"name":"Invalid token on protected endpoint","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer invalid-token"}],"url":"{{baseUrl}}/api/v1/farms"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns 401',()=>pm.response.to.have.status(401));"]}}]},
      {"name":"Expired supported token on protected endpoint","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{expiredToken}}"}],"url":"{{baseUrl}}/api/v1/farms"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns 401',()=>pm.response.to.have.status(401));"]}}]},
      {"name":"Admin can list users","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"}],"url":"{{baseUrl}}/api/v1/users"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns 200',()=>pm.response.to.have.status(200));"]}}]},
      {"name":"ECTA Officer denied user administration","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{ectaToken}}"}],"url":"{{baseUrl}}/api/v1/users"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns 403',()=>pm.response.to.have.status(403));"]}}]},
      {"name":"Field Agent denied role escalation","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{fieldToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"username\":\"qa004-escalation-{{runId}}\",\"password\":\"not-persisted\",\"full_name\":\"QA Escalation Attempt\",\"role\":\"Admin\"}"},"url":"{{baseUrl}}/api/v1/users"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns 403',()=>pm.response.to.have.status(403));"]}}]},
      {"name":"Verifier denied user administration","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{verifierToken}}"}],"url":"{{baseUrl}}/api/v1/users"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns 403',()=>pm.response.to.have.status(403));"]}}]}
    ]},
    {"name":"Core operational role matrix","item":[
      {"name":"Field Agent creates synthetic Farmer","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{fieldToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"full_name\":\"QA004 Synthetic Farmer\",\"national_id\":\"{{nationalId}}\",\"gender\":\"Unspecified\",\"phone_number\":\"+251900000004\"}"},"url":"{{baseUrl}}/api/v1/farmers"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns 201',()=>pm.response.to.have.status(201));","const b=pm.response.json(); pm.expect(b.farmer_id).to.be.a('number'); pm.collectionVariables.set('farmerId',b.farmer_id);"]}}]},
      {"name":"ECTA Officer denied Farmer creation","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{ectaToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"full_name\":\"QA004 Denied\",\"national_id\":\"QA004-denied-officer-{{runId}}\"}"},"url":"{{baseUrl}}/api/v1/farmers"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns 403',()=>pm.response.to.have.status(403));"]}}]},
      {"name":"Verifier denied Farmer creation","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{verifierToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"full_name\":\"QA004 Denied\",\"national_id\":\"QA004-denied-verifier-{{runId}}\"}"},"url":"{{baseUrl}}/api/v1/farmers"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns 403',()=>pm.response.to.have.status(403));"]}}]},
      {"name":"Admin creates Farm","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"farmer_id\":{{farmerId}},\"geometry\":{\"type\":\"Point\",\"coordinates\":[38.75,9.0]},\"radius_meters\":100}"},"url":"{{baseUrl}}/api/v1/farms"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns 201',()=>pm.response.to.have.status(201));","const b=pm.response.json(); pm.collectionVariables.set('farmId',b.farm_id);"]}}]},
      {"name":"ECTA Officer denied Farm creation","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{ectaToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"farmer_id\":{{farmerId}},\"geometry\":{\"type\":\"Point\",\"coordinates\":[38.75,9.0]},\"radius_meters\":100}"},"url":"{{baseUrl}}/api/v1/farms"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns 403',()=>pm.response.to.have.status(403));"]}}]},
      {"name":"Field Agent creates Lot with ignored authority fields","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{fieldToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"farm_id\":{{farmId}},\"created_by\":999999,\"gin_code\":\"CLIENT-CONTROLLED\",\"status\":\"approved\"}"},"url":"{{baseUrl}}/api/v1/lots"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns 201',()=>pm.response.to.have.status(201));","const b=pm.response.json(); pm.expect(b.created_by).to.eql(Number(pm.collectionVariables.get('fieldUserId'))); pm.expect(b.status).to.eql('created'); pm.expect(b.gin_code).not.to.eql('CLIENT-CONTROLLED'); pm.collectionVariables.set('lotId',b.lot_id);"]}}]},
      {"name":"ECTA Officer denied Lot creation","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{ectaToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"farm_id\":{{farmId}}}"},"url":"{{baseUrl}}/api/v1/lots"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns 403',()=>pm.response.to.have.status(403));"]}}]},
      {"name":"Verifier denied Lot creation","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{verifierToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"farm_id\":{{farmId}}}"},"url":"{{baseUrl}}/api/v1/lots"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns 403',()=>pm.response.to.have.status(403));"]}}]},
      {"name":"ECTA Officer appends event with server identity","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{ectaToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"event_type\":\"qa004_event\",\"notes\":\"Synthetic QA-004 event\",\"recorded_by\":999999}"},"url":"{{baseUrl}}/api/v1/lots/{{lotId}}/events"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns 201',()=>pm.response.to.have.status(201));","pm.expect(pm.response.json().recorded_by).to.eql(Number(pm.collectionVariables.get('ectaUserId')));"]}}]},
      {"name":"Verifier reads protected trace","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{verifierToken}}"}],"url":"{{baseUrl}}/api/v1/lots/{{lotId}}/trace"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns 200',()=>pm.response.to.have.status(200));","pm.expect(pm.response.json().events).to.be.an('array').and.not.empty;"]}}]}
    ]},
    {"name":"QR public/private boundary","item":[
      {"name":"Admin generates QR without internals","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"regenerate\":false}"},"url":"{{baseUrl}}/api/v1/lots/{{lotId}}/qr"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns 201',()=>pm.response.to.have.status(201));","const b=pm.response.json(); pm.expect(b.image_svg).to.match(/^data:image\\/svg\\+xml;base64,/); pm.expect(b.image_png_data_url).to.match(/^data:image\\/png;base64,/); pm.expect(JSON.stringify(b)).not.to.include('payload_hash'); pm.expect(JSON.stringify(b)).not.to.include('hmac_signature'); const m=b.verification_url.match(/[?&]sig=([^&]+)/); pm.expect(m).to.not.equal(null); pm.collectionVariables.set('qrId',b.qr_id); pm.collectionVariables.set('qrSignature',m[1]);"]}}]},
      {"name":"Field Agent reuses active QR","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{fieldToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"regenerate\":false}"},"url":"{{baseUrl}}/api/v1/lots/{{lotId}}/qr"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns 200',()=>pm.response.to.have.status(200));","pm.expect(pm.response.json().qr_id).to.eql(Number(pm.collectionVariables.get('qrId')));"]}}]},
      {"name":"ECTA Officer denied QR generation","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{ectaToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{}"},"url":"{{baseUrl}}/api/v1/lots/{{lotId}}/qr"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns 403',()=>pm.response.to.have.status(403));"]}}]},
      {"name":"Verifier denied QR generation","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{verifierToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{}"},"url":"{{baseUrl}}/api/v1/lots/{{lotId}}/qr"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns 403',()=>pm.response.to.have.status(403));"]}}]},
      {"name":"Public QR verification requires no token and minimizes data","request":{"method":"GET","url":"{{baseUrl}}/api/v1/verify/{{qrId}}?sig={{qrSignature}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns 200 without Authorization',()=>pm.response.to.have.status(200));","const b=pm.response.json(); pm.expect(b.status).to.eql('valid'); const raw=JSON.stringify(b); ['national_id','phone_number','payload_hash','hmac_signature','signature','geometry'].forEach(k=>pm.expect(raw).not.to.include(k));"]}}]},
      {"name":"Tampered public QR signature is rejected","request":{"method":"GET","url":"{{baseUrl}}/api/v1/verify/{{qrId}}?sig={{qrSignature}}tampered"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('returns 400',()=>pm.response.to.have.status(400));"]}}]}
    ]}
  ]
}
