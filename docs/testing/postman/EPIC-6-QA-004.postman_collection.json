  },
  "variable": [
    {"key":"baseUrl","value":"http://127.0.0.1:8002"},
    {"key":"adminUsername","value":"qa.admin"}, {"key":"adminPassword","value":""}, {"key":"adminToken","value":""}, {"key":"adminUserId","value":""},
    {"key":"ectaUsername","value":"qa.ecta"}, {"key":"ectaPassword","value":""}, {"key":"ectaToken","value":""}, {"key":"ectaUserId","value":""},
    {"key":"fieldUsername","value":"qa.field"}, {"key":"fieldPassword","value":""}, {"key":"fieldToken","value":""}, {"key":"fieldUserId","value":""},
    {"key":"verifierUsername","value":"qa.verifier"}, {"key":"verifierPassword","value":""}, {"key":"verifierToken","value":""}, {"key":"verifierUserId","value":""},
    {"key":"expiredToken","value":""}, {"key":"runId","value":""}, {"key":"nationalId","value":""}, {"key":"farmerId","value":""}, {"key":"farmId","value":""}, {"key":"lotId","value":""}, {"key":"qrId","value":""}, {"key":"qrSignature","value":""}
